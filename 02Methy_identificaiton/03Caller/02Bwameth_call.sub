#!/bin/bash 
#SBATCH -J bwa_caller
#SBATCH -c 20
#SBATCH --mem=120G
#SBATCH -t 48:00:00
#SBATCH -p requeue,general
#SBATCH -o %x.%j.out
#SBATCH -e %x.%j.err

#Sample information
sample=$1
inputdir=$2
reference=$3
resultdir=$4

##02 bwameth
MethylDackel extract \
  -@ 20 \
  --cytosine_report \
  $reference \
  $inputdir/${sample}.bwameth.sorted.dedup.bam \
  -o $resultdir/$sample.bwameth
